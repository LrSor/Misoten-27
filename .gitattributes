* text=auto

*.cs      text eol=lf
*.shader  text eol=lf
*.hlsl    text eol=lf
*.cginc   text eol=lf
*.json    text eol=lf
*.asmdef  text eol=lf
*.asmref  text eol=lf
*.unity   text eol=lf
*.prefab  text eol=lf
# Unity .asset files can be YAML or binary (for example lighting/navmesh data).
*.asset   text=auto eol=lf
*.meta    text eol=lf

# Keep binary assets byte-for-byte intact on every platform.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.bmp binary
*.tga binary
*.tif binary
*.tiff binary
*.exr binary
*.hdr binary
*.dds binary
*.webp binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.dll binary
*.so binary
*.dylib binary
*.zip binary
*.7z binary
*.unitypackage binary
*.mp3 binary
*.ogg binary
*.aif binary
*.aiff binary
*.flac binary
*.avi binary
*.mov binary
*.webm binary

.gitattributes text eol=lf
.gitignore text eol=lf

# Preserve the existing Git LFS storage rules.
*.psd filter=lfs diff=lfs merge=lfs -text
*.psb filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text
